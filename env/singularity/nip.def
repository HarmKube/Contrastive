BootStrap: library
From: ubuntu:22.04

%environment
    # set up all essential environment variables
    export LC_ALL=C
    export PATH=/miniconda3/bin:$PATH
    export PYTHONPATH=/miniconda3/lib/python3.9/:$PYTHONPATH
    
    # activate conda environment
    source activate base;
    conda activate;

%files
    ./env/requirements.txt /requirements.txt
    
%post
    # update and install essential dependencies
    apt -y update
    apt update && apt install -y automake build-essential bzip2 wget git unzip
    apt-get update && apt-get install ffmpeg libsm6 libxext6  -y
	apt clean
    
    # download, install, and update miniconda3
    wget https://repo.continuum.io/miniconda/Miniconda3-latest-Linux-x86_64.sh
    bash Miniconda3-latest-Linux-x86_64.sh -b -f -p /miniconda3/
    rm Miniconda3-latest-Linux-x86_64.sh
    
    # install dependencies via conda
    export PATH="/miniconda3/bin:$PATH"
    conda install -y python=3.9
    export PYTHONPATH=/miniconda3/lib/python3.9/:$PYTHONPATH

    # activate conda environment
    . /miniconda3/etc/profile.d/conda.sh
    conda activate base

    # make sure we use conda's pip
    conda install -y pip

    # check pip path (optional debug print)
    which pip

    # Install packages from requirements file
    pip install -r /requirements.txt
    conda clean --all
    
	mkdir /myconfigs
    mkdir /mysrc
	mkdir /mydata
    cd /mysrc
    mkdir ./datasets


%test
    python -c "import torch; print(torch.__version__)"


%help
    This container comes with pytorch, cuda and matlab support
    Use the following mounting points
    myconfigs
    mydata
    mysrc


%labels
    Author NIP Project Group
    Version v0.0
    MyLabel Hello GPU World
